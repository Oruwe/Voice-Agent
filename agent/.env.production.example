# Production environment reference.
# NEVER put real credentials in this file.

# --- shared ---
DATABASE_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- token service ---
JWT_SECRET=
JWT_ISSUER=voice-agent-platform
ENVIRONMENT=development
ALLOWED_ORIGINS=

# --- agent worker ---
LIVEKIT_URL=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
SARVAM_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Zero-latency voice path tuning (all optional; defaults shown) ---
# llama-3.3-70b-versatile: best quality/speed tradeoff on Groq (~250 tok/s, no reasoning overhead)
# llama-3.1-8b-instant: fastest option (~600 tok/s) for simpler queries
GROQ_MODEL=llama-3.3-70b-versatile
LLM_ATTEMPT_TIMEOUT=6
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=transcribe
SARVAM_STT_HIGH_VAD=true
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SAMPLE_RATE=22050
SARVAM_TTS_MIN_BUFFER=30
SARVAM_TTS_PACE=1.1
MIN_ENDPOINTING_DELAY=0.35
MAX_ENDPOINTING_DELAY=2.5
MOSS_TOP_K=3
MOSS_BUDGET_MS=60
AGENT_GREETING=Hi, I'm your field ops assistant. What do you need help with?
NUM_IDLE_PROCESSES=1

# --- Qdrant knowledge base (optional; agent runs without it) ---
# Leave QDRANT_URL blank to disable Qdrant entirely (Moss still handles session memory).
# For local: http://localhost:6333  |  For Qdrant Cloud: https://xyz.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TOP_K=3
