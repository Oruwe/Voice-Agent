# Environment reference. Copy to `.env` and fill in the blanks:
#     cp .env.production.example .env
# NEVER put real credentials in THIS file -- only in your own .env.
#
# Only the sections above "Zero-latency voice path tuning" need filling in.
# Everything below that already has a working default; leave it alone for a
# first run. Once this file is complete, verify every service at once with:
#     python preflight_check.py

# --- shared ---
# Matches the Postgres in this repo's docker-compose.yml, already running
# after `docker-compose up -d`. The scheme MUST be postgresql+asyncpg://
# (plain postgresql:// fails at startup):
#     postgresql+asyncpg://voiceagent:voiceagent@localhost:5432/voiceagent
DATABASE_URL=
# LiveKit Cloud (cloud.livekit.io): create a project, then create an API key
# under its settings. The SECRET is shown only once -- copy it right away.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- token service ---
# Self-generated, not from any provider. Any long random string:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=voice-agent-platform
ENVIRONMENT=development
# The frontend's origin, exactly. Vite's dev server is http://localhost:5173
ALLOWED_ORIGINS=

# --- agent worker ---
# From the same LiveKit project as the key/secret above; looks like
# wss://your-project.livekit.cloud
LIVEKIT_URL=
# Moss (usemoss.dev): a project gives you TWO values, not one key --
# MossClient(project_id, project_key). See app/context/moss_provider.py.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Sarvam (sarvam.ai): one key covers STT, TTS, and (optionally) the LLM.
SARVAM_API_KEY=
# Groq (console.groq.com): starts with gsk_
GROQ_API_KEY=
# Google AI Studio (aistudio.google.com): free tier, no billing required.
GOOGLE_API_KEY=
# gemini-2.0-flash and the 2.5 models are retired for new keys; preflight
# names the problem if this one is ever retired too.
GEMINI_MODEL=gemini-3.5-flash-lite

# ===========================================================================
# Everything below is ALREADY TUNED and optional. Nothing here needs a value
# from you -- the defaults shown are the ones the latency work settled on.
# Skip this whole section on a first run; come back when benchmarking.
# ===========================================================================

# --- Zero-latency voice path tuning (all optional; defaults shown) ---
# LLM fallback chain, tried left to right. FallbackAdapter is a circuit
# breaker: a provider that errors (e.g. a Groq free-tier 429) is marked
# unavailable and every later turn skips it until a background probe
# recovers it -- so a rate-limited primary means you are really running on
# the next entry, not on the one you named first.
#   groq,gemini          default; unchanged from before this was configurable
#   sarvam,groq,gemini   Sarvam LLM first -- Indian infrastructure, so far
#                        lower RTT from India than Groq's US endpoint, and
#                        it reuses SARVAM_API_KEY. Unverified here: tool-call
#                        quality vs llama-3.3-70b, and whether Sarvam meters
#                        LLM against the same quota as STT/TTS. Benchmark it
#                        with latency_report.py before trusting it.
LLM_CHAIN=groq,gemini
# llama-3.3-70b-versatile was decommissioned for free/developer keys on
# 2026-08-16; gpt-oss-120b is Groq's recommended replacement. It reasons
# before answering, so keep GROQ_REASONING_EFFORT=low for voice. Leave that
# empty for a model that doesn't reason -- Groq rejects the parameter.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
SARVAM_LLM_MODEL=sarvam-105b-conversations
LLM_ATTEMPT_TIMEOUT=4
LLM_TEMPERATURE=0.6
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_MODE=transcribe
SARVAM_STT_HIGH_VAD=true
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_MIN_BUFFER=30
SARVAM_TTS_MAX_CHUNK=150
SARVAM_TTS_PACE=1.05
MIN_ENDPOINTING_DELAY=0.25
MAX_ENDPOINTING_DELAY=2.0
# Barge-in: "vad" = local Silero VAD, free, identical in dev and prod.
# "adaptive" uses LiveKit's hosted ML detector (extra network hop, more
# accurate at ignoring "mmhm"/background noise) but only activates by
# default in local dev -- pin it here so behavior doesn't silently differ.
INTERRUPTION_MODE=vad
MIN_INTERRUPTION_DURATION=0.3
MIN_INTERRUPTION_WORDS=0
MOSS_TOP_K=3
MOSS_BUDGET_MS=40
AGENT_GREETING=Hi, I'm your field ops assistant. What do you need help with?
NUM_IDLE_PROCESSES=1

# Per-turn latency benchmarking. Blank (the default) = disabled entirely:
# nothing is opened or written. Set to a path to append one JSON line of
# timings per turn (timings only -- never transcript text), then aggregate:
#   python latency_report.py run.jsonl
#   python latency_report.py before.jsonl after.jsonl --markdown
# On a deployed worker use `stdout`: rows go to the log stream prefixed
# LATENCY_ROW, and latency_report.py reads them straight from a log export.
LATENCY_LOG_PATH=

# --- Qdrant knowledge base (optional; agent runs without it) ---
# Leave QDRANT_URL blank to disable Qdrant entirely (Moss still handles session memory).
# For local: http://localhost:6333  |  For Qdrant Cloud: https://xyz.qdrant.io
# The local URL is the Qdrant from this repo's docker-compose.yml, already
# running after `docker-compose up -d`. No API key needed for local.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TOP_K=3
